{
  "schema": 1,
  "order": [
    "xr-kernel",
    "xr-mesa",
    "xr-vendor-assets",
    "xr-hexagonrpc",
    "xr-device-io",
    "xr-head-tracking",
    "xr-controller-tracking",
    "xr-spatial-kit",
    "xr-hand-tracking",
    "xr-monado",
    "xr-shell",
    "xr-environments",
    "xr-dock",
    "xr-system-ui",
    "xr-wayland",
    "xr-session-manager",
    "xr-debug-console",
    "xr-image-tools",
    "openkylin-xr-integration",
    "xr-cinema"
  ],
  "components": {
    "xr-cinema": {
      "kind": "component-script",
      "script": "packaging/build-component.py"
    },
    "xr-kernel": {
      "kind": "kernel-device",
      "device": "a081",
      "version": "7.3.0+xr7"
    },
    "xr-hexagonrpc": {
      "kind": "debian"
    },
    "xr-device-io": {
      "kind": "debian"
    },
    "xr-head-tracking": {
      "kind": "debian"
    },
    "xr-controller-tracking": {
      "kind": "debian"
    },
    "xr-spatial-kit": {
      "kind": "debian"
    },
    "xr-hand-tracking": {
      "kind": "debian",
      "directories": [
        ".",
        "backends/quest"
      ]
    },
    "xr-monado": {
      "kind": "debian",
      "cargo_manifest": "compat/passthrough/Cargo.toml",
      "required_compiler_headers": [
        "xr/head/production-v2/a081_qvr_pose.h",
        "xr/head/production-v2/a081_tracking_wire.h",
        "xr/head/production-v2/a081_tracking_client.h",
        "xr/device/a081_controller_haptics.h"
      ]
    },
    "xr-shell": {
      "kind": "debian"
    },
    "xr-environments": {
      "kind": "debian"
    },
    "xr-dock": {
      "kind": "debian"
    },
    "xr-system-ui": {
      "kind": "debian"
    },
    "xr-wayland": {
      "kind": "debian"
    },
    "xr-session-manager": {
      "kind": "debian"
    },
    "xr-debug-console": {
      "kind": "debian",
      "cargo_manifest": "backend/Cargo.toml"
    },
    "openkylin-xr-integration": {
      "kind": "debian"
    },
    "xr-vendor-assets": {
      "kind": "vendor"
    },
    "xr-image-tools": {
      "kind": "debian"
    },
    "xr-mesa": {
      "kind": "mesa"
    }
  },
  "profile_recipes": {
    "vr700-simulated": {
      "xr-monado": {
        "kind": "cmake-runtime",
        "configure": [
          "-DCMAKE_BUILD_TYPE=Release",
          "-DCMAKE_INSTALL_PREFIX=/opt/xr/vr700-simulated",
          "-DCMAKE_INSTALL_LIBDIR=lib",
          "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF",
          "-DBUILD_TESTING=OFF",
          "-DGIT_DESC=xr-simulated-runtime",
          "-DXRT_FEATURE_STEAMVR_PLUGIN=OFF",
          "-DXRT_FEATURE_OPENXR=ON",
          "-DXRT_FEATURE_SERVICE=ON",
          "-DXRT_FEATURE_SERVICE_SYSTEMD=OFF",
          "-DXRT_INSTALL_SYSTEMD_UNIT_FILES=OFF",
          "-DXRT_HAVE_VULKAN=ON",
          "-DXRT_HAVE_WAYLAND=ON",
          "-DXRT_HAVE_WAYLAND_DIRECT=OFF",
          "-DXRT_HAVE_XCB=OFF",
          "-DXRT_HAVE_XLIB=OFF",
          "-DXRT_HAVE_XRANDR=OFF",
          "-DXRT_HAVE_OPENGL=OFF",
          "-DXRT_HAVE_OPENGLES=OFF",
          "-DXRT_HAVE_EGL=OFF",
          "-DXRT_HAVE_SDL2=OFF",
          "-DXRT_HAVE_OPENCV=OFF",
          "-DXRT_HAVE_LIBUDEV=OFF",
          "-DXRT_HAVE_DBUS=OFF",
          "-DXRT_HAVE_SYSTEMD=OFF",
          "-DXRT_HAVE_GST=OFF",
          "-DXRT_HAVE_LIBUSB=OFF",
          "-DXRT_HAVE_HIDAPI=OFF",
          "-DXRT_HAVE_V4L2=OFF",
          "-DXRT_FEATURE_SLAM=OFF",
          "-DXRT_FEATURE_DEBUG_GUI=OFF",
          "-DXRT_FEATURE_CLIENT_DEBUG_GUI=OFF",
          "-DXRT_FEATURE_WINDOW_PEEK=OFF",
          "-DXRT_MODULE_MONADO_GUI=OFF",
          "-DXRT_MODULE_MONADO_CLI=OFF",
          "-DXRT_MODULE_AUX_VIVE=OFF",
          "-DXRT_MODULE_AUX_HTC=OFF",
          "-DXRT_MODULE_MERCURY_HANDTRACKING=OFF",
          "-DXRT_BUILD_DRIVER_A081=OFF",
          "-DXRT_BUILD_DRIVER_ANDROID=OFF",
          "-DXRT_BUILD_DRIVER_ARDUINO=OFF",
          "-DXRT_BUILD_DRIVER_BLUBUR_S1=OFF",
          "-DXRT_BUILD_DRIVER_CONTACTGLOVE=OFF",
          "-DXRT_BUILD_DRIVER_DAYDREAM=OFF",
          "-DXRT_BUILD_DRIVER_DEPTHAI=OFF",
          "-DXRT_BUILD_DRIVER_EUROC=OFF",
          "-DXRT_BUILD_DRIVER_HANDTRACKING=OFF",
          "-DXRT_BUILD_DRIVER_HDK=OFF",
          "-DXRT_BUILD_DRIVER_HYDRA=OFF",
          "-DXRT_BUILD_DRIVER_ILLIXR=OFF",
          "-DXRT_BUILD_DRIVER_NS=OFF",
          "-DXRT_BUILD_DRIVER_OHMD=OFF",
          "-DXRT_BUILD_DRIVER_OPENGLOVES=OFF",
          "-DXRT_BUILD_DRIVER_PSMV=OFF",
          "-DXRT_BUILD_DRIVER_PSSENSE=OFF",
          "-DXRT_BUILD_DRIVER_PSVR=OFF",
          "-DXRT_BUILD_DRIVER_PSVR2=OFF",
          "-DXRT_BUILD_DRIVER_QWERTY=OFF",
          "-DXRT_BUILD_DRIVER_REALSENSE=OFF",
          "-DXRT_BUILD_DRIVER_REMOTE=OFF",
          "-DXRT_BUILD_DRIVER_RIFT=OFF",
          "-DXRT_BUILD_DRIVER_RIFT_S=OFF",
          "-DXRT_BUILD_DRIVER_RIFT_SENSOR=OFF",
          "-DXRT_BUILD_DRIVER_ROKID=OFF",
          "-DXRT_BUILD_DRIVER_SIMULATED=ON",
          "-DXRT_BUILD_DRIVER_SIMULAVR=OFF",
          "-DXRT_BUILD_DRIVER_SOLARXR=OFF",
          "-DXRT_BUILD_DRIVER_STEAMVR_LIGHTHOUSE=OFF",
          "-DXRT_BUILD_DRIVER_SURVIVE=OFF",
          "-DXRT_BUILD_DRIVER_TWRAP=OFF",
          "-DXRT_BUILD_DRIVER_ULV2=OFF",
          "-DXRT_BUILD_DRIVER_ULV5=OFF",
          "-DXRT_BUILD_DRIVER_UVC=OFF",
          "-DXRT_BUILD_DRIVER_VF=OFF",
          "-DXRT_BUILD_DRIVER_VIVE=OFF",
          "-DXRT_BUILD_DRIVER_WMR=OFF",
          "-DXRT_BUILD_DRIVER_XREAL_AIR=OFF"
        ],
        "targets": [
          "monado-service",
          "openxr_monado"
        ],
        "files": {
          "src/xrt/targets/service/monado-service": "bin/monado-service",
          "src/xrt/targets/openxr/libopenxr_monado.so": "lib/libopenxr_monado.so"
        }
      }
    },
    "vr700-kernel": {
      "xr-kernel": {
        "kind": "kernel-device",
        "device": "vr700",
        "version": "7.3.0+xr.vr700.2"
      }
    },
    "saberv": {
      "xr-monado": {
        "kind": "source"
      },
      "openkylin-xr-integration": {
        "kind": "component-script",
        "script": "applications/rvvr-saberv/build.py"
      }
    }
  }
}

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Run the desktop in the selected WiVRn runtime without changing global state."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


def main():
    arguments = sys.argv[1:]
    wait = '--wait-for-headset' in arguments
    if wait:
        arguments.remove('--wait-for-headset')
    # WiVRn starts the configured application before publishing headset_info
    # on D-Bus. Only its automatic entry gets a bounded readiness grace period.
    deadline = time.monotonic() + (15 if wait else 0)
    while True:
        status = subprocess.run(
            ['gdbus', 'call', '--session', '--dest', 'io.github.wivrn.Server',
             '--object-path', '/io/github/wivrn/Server',
             '--method', 'org.freedesktop.DBus.Properties.Get',
             'io.github.wivrn.Server', 'HeadsetConnected'],
            capture_output=True, text=True, timeout=3)
        if status.returncode == 0 and status.stdout.strip() == '(<true>,)':
            break
        if status.returncode or time.monotonic() >= deadline:
            raise RuntimeError('Connect a headset in the WiVRn console before starting the XR desktop.')
        time.sleep(.2)
    if os.environ.get('XR_RUNTIME_JSON'):
        candidates = [Path(os.environ['XR_RUNTIME_JSON'])]
    else:
        config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
        candidates = [config / 'openxr/1/active_runtime.json',
                      Path('/etc/xdg/openxr/1/active_runtime.json'),
                      Path('/usr/local/share/openxr/1/openxr_wivrn.json'),
                      Path('/usr/share/openxr/1/openxr_wivrn.json')]
    runtime = None
    for candidate in candidates:
        try:
            candidate = candidate.resolve(strict=True)
            info = json.loads(candidate.read_text())['runtime']
            if 'wivrn' not in (info.get('name', '') + info['library_path']).lower():
                continue
            library = Path(info['library_path'])
            if not library.is_absolute():
                library = candidate.parent / library
            if library.is_file():
                runtime = candidate
                break
        except (OSError, ValueError, KeyError, TypeError):
            continue
    if runtime is None:
        raise RuntimeError('WiVRn runtime unavailable. Start WiVRn and connect the headset, '
                           'or set XR_RUNTIME_JSON to its installed runtime manifest.')
    session = shutil.which('xr-shell-session')
    if session is None:
        raise RuntimeError('Install xr-shell-session and the streaming desktop components.')
    # The streaming runtime owns tracking and environment composition.
    for key in ('XR_SYSTEM_CONTROLS_COMMAND', 'XR_SESSION_CONTROLS_FILE',
                'XR_INPUT_STATUS_FILE', 'XR_SCENE_CONTROLS_STATUS_FILE',
                'XR_CONTROLLER_MODEL_DIR', 'XROS_PASSTHROUGH_CONFIG',
                'XR_RUNTIME_PASSTHROUGH_STATUS_FILE', 'XROS_SESSION_TOKEN'):
        os.environ.pop(key, None)
    layers = [v for v in os.environ.get('XR_ENABLE_API_LAYERS', '').split(os.pathsep)
              if v and v != 'XR_APILAYER_XROS_passthrough']
    if layers:
        os.environ['XR_ENABLE_API_LAYERS'] = os.pathsep.join(layers)
    else:
        os.environ.pop('XR_ENABLE_API_LAYERS', None)
    os.environ['XR_RUNTIME_JSON'] = str(runtime)
    # Route this scene's PulseAudio clients to the headset without changing
    # the host desktop's default devices. Explicit user choices still win.
    os.environ.setdefault('PULSE_SINK', 'wivrn.sink')
    os.environ.setdefault('PULSE_SOURCE', 'wivrn.source')
    print('Using WiVRn runtime: ' + str(runtime), flush=True)
    os.execv(session, [session, *arguments])


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('xr-shell-wivrn: ' + str(error), file=sys.stderr)
        sys.exit(1)

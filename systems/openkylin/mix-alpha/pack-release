#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Package the system and recovery images at the archive root.
set -euo pipefail
if [[ $# -lt 2 || $# -gt 3 ]]; then echo 'Usage: pack-release PAYLOAD_DIRECTORY OUTPUT_DIRECTORY [rNUMBER]' >&2; exit 2; fi
payload=$(realpath "$1")
output=$(realpath "$2")
base=openKylin-3.0-Spatial-Alpha-MIX
archive=$base
if [[ $# == 3 ]]; then
    [[ $3 =~ ^r[1-9][0-9]*$ ]] || exit 2
    archive="$base-$3"
fi
[[ ${payload##*/} == "$base" && "$output" != "$payload" && "$output" != "$payload/"* ]]
members=("$base-arm64.img" "$base-recovery.img")
for member in "${members[@]}"; do
    [[ -f "$payload/$member" && ! -L "$payload/$member" ]]
done
temp=$(mktemp -d "$output/.compress.XXXXXX")
trap 'rm -f "$temp/$archive.tar.xz" "$temp/$archive.tar.xz.sha256" "$temp/SHA256SUMS"; rmdir "$temp"' EXIT
( cd "$payload"; sha256sum "${members[@]}" ) > "$temp/SHA256SUMS"
tar --format=gnu --sparse --owner=0 --group=0 -C "$payload" -cf - "${members[@]}" |
    xz -2 -T8 -c > "$temp/$archive.tar.xz"
xz -T8 -t "$temp/$archive.tar.xz"
( cd "$temp"; sha256sum "$archive.tar.xz" > "$archive.tar.xz.sha256" )
mv "$temp/$archive.tar.xz" "$temp/$archive.tar.xz.sha256" "$temp/SHA256SUMS" "$output/"

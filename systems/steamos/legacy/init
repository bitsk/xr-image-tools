#!/bin/sh
# PID 1: Debian fallback, explicit one-shot override, optional persistent default.
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /run
mkdir -p /sys/kernel/config
mount -t configfs configfs /sys/kernel/config
fail() {
    echo "A081 dual-root initramfs: $*" > /dev/kmsg
    (sleep 120; sync; reboot -f) &
    while :; do setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done
}
g=/sys/kernel/config/usb_gadget/a081
mkdir -p "$g" || exit 1
cd "$g" || exit 1
printf 0x18d1 > idVendor
printf 0x4ee7 > idProduct
printf 0x0200 > bcdUSB
printf 0x0100 > bcdDevice
mkdir -p strings/0x409 configs/c.1 functions/acm.usb0
printf 'Qiyu MIX' > strings/0x409/manufacturer
printf 'A081 recovery console' > strings/0x409/product
# Keep the proven maintenance transport, including before a root is selected.
# /etc/a081-rootfs-id and /run/a081-handoff identify the actual running system.
printf A081-DEBIAN > strings/0x409/serialnumber
ln -s "$g/functions/acm.usb0" configs/c.1/acm.usb0
n=0
while [ "$n" -lt 60 ]; do
    for p in /sys/class/udc/a600000.*; do
        [ -e "$p" ] || continue
        echo "${p##*/}" > UDC && break 2
    done
    sleep 1; n=$((n+1))
done
cd /
n=0
while [ ! -b /dev/sda16 ] && [ "$n" -lt 60 ]; do sleep 1; n=$((n+1)); done
[ -b /dev/sda16 ] || fail 'osstore device missing'
# Installation identity is supplied locally, never embedded in public source.
osstore_uuid=
[ ! -r /etc/qiyu-device.conf ] || . /etc/qiyu-device.conf
[ ! -r /etc/xr-device.conf ] || . /etc/xr-device.conf
for arg in $(cat /proc/cmdline); do
    case "$arg" in xr.osstore_uuid=*|qiyu.osstore_uuid=*) osstore_uuid=${arg#*=};; esac
done
[ -n "$osstore_uuid" ] || fail 'Supply qiyu.osstore_uuid or local qiyu-device.conf'
blkid /dev/sda16 | grep -Fq "UUID=\"$osstore_uuid\"" || fail 'osstore UUID mismatch'
mount -t ext4 -o noatime /dev/sda16 /osstore || fail 'osstore mount failed'

debian_root=/osstore/systems/debian/rootfs
steamos_root=/osstore/systems/steamos/rootfs
openkylin_root=/osstore/systems/openkylin/rootfs
selector=/osstore/boot/next-system
default_selector=/osstore/boot/default-system
selected=debian
requested=debian
selection_source=default
reason=default
root="$debian_root"

# The verified Debian fallback must exist even for a requested optional root.
[ "$(cat "$debian_root/etc/a081-rootfs-id" 2>/dev/null)" = a081-debian-trixie-arm64 ] || fail 'Debian fallback marker missing'
[ -x "$debian_root/sbin/init" ] || fail 'Debian fallback systemd missing'
if [ -e "$selector" ] || [ -L "$selector" ]; then
    selection_source=one-shot
    requested=invalid
    if [ -f "$selector" ] && [ ! -L "$selector" ]; then
        requested=$(cat "$selector")
    fi
    # A one-shot always wins, including an invalid request. Consume it before
    # checking the requested root; a failed override must go directly to Debian.
    if ! { rm -f "$selector" && sync; }; then
        selection_source=failed-one-shot
        requested=debian
        reason=selector-consume-failed
        echo 'A081: cannot consume next-system; using Debian' > /dev/kmsg
    fi
elif [ -e "$default_selector" ] || [ -L "$default_selector" ]; then
    selection_source=persistent-default
    requested=invalid
    if [ -f "$default_selector" ] && [ ! -L "$default_selector" ]; then
        requested=$(cat "$default_selector")
    fi
fi
if [ "$selection_source" != failed-one-shot ]; then
    case "$requested" in
        steamos|openkylin)
            if [ "$requested" = steamos ]; then
                candidate_root="$steamos_root"
                candidate_marker=a081-steamos-arm64
            else
                candidate_root="$openkylin_root"
                candidate_marker=a081-openkylin-3.0-arm64
            fi
            if [ "$(cat "$candidate_root/etc/a081-rootfs-id" 2>/dev/null)" = "$candidate_marker" ] &&
               [ -x "$candidate_root/sbin/init" ]; then
                selected="$requested"
                root="$candidate_root"
                reason="$selection_source"
            else
                reason="invalid-$requested-root"
                echo "A081: $requested installation unavailable; using Debian" > /dev/kmsg
            fi
            ;;
        debian)
            case "$selection_source" in
                one-shot) reason=explicit-debian ;;
                persistent-default) reason=persistent-default ;;
            esac
            ;;
        *)
            if [ "$selection_source" = persistent-default ]; then
                reason=invalid-default-selector
            else
                reason=invalid-selector
            fi
            ;;
    esac
fi
if ! mount --bind "$root" /newroot; then
    [ "$selected" != debian ] || fail 'Debian root bind failed'
    reason="$selected-bind-failed"
    selected=debian
    root="$debian_root"
    mount --bind "$root" /newroot || fail 'Debian fallback root bind failed'
fi
mkdir -p /newroot/osstore /newroot/run /newroot/dev /newroot/proc /newroot/sys
mount --move /osstore /newroot/osstore || fail 'store move failed'
# Retain the verified baseline clock seeding policy.
now=$(date +%s)
seed=$(cat /build-epoch)
if [ -r /newroot/osstore/boot/clock-epoch ]; then
    saved=$(cat /newroot/osstore/boot/clock-epoch)
    case "$saved" in ''|*[!0-9]*) ;; *) [ "$saved" -le "$seed" ] || seed=$saved ;; esac
fi
[ "$now" -ge "$seed" ] || date -s "@$seed"
cat /proc/cmdline > /run/a081-initramfs-cmdline
printf 'osstore UUID verified; selected=%s; reason=%s; root=%s; switching to systemd\n' \
    "$selected" "$reason" "$root" > /run/a081-handoff
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run
exec switch_root /newroot /sbin/init
